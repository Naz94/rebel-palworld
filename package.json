{
  "name": "rebel-palworld",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pal:watch": "node ./tools/pal-save-import/watch-save.mjs",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "api:dev": "pnpm --filter api dev",
    "rebel": "concurrently --kill-others-on-fail --names WEB,API,SAVE \"pnpm web:dev\" \"pnpm api:dev\" \"pnpm pal:watch\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "connector:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/pal-save-import/rebel-background-connector.ps1 Install",
    "connector:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/pal-save-import/rebel-background-connector.ps1 Status",
    "connector:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/pal-save-import/rebel-background-connector.ps1 Start",
    "connector:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/pal-save-import/rebel-background-connector.ps1 Stop",
    "connector:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/pal-save-import/rebel-background-connector.ps1 Uninstall"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "supabase": "^2.114.0"
  }
}
